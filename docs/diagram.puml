@startuml

' =========================
' APPOINTMENT
' =========================

class AppointmentRouter {
    + create()
    + confirm()
    + cancel()
}

interface IAppointmentService {
    + check_availability(professional, datetime_slot)
    + create_appointment(professional_id, client_id, datetime_slot)
    + get_by_id(appointment_id)
    + confirm_appointment(appointment_id)
    + cancel_appointment(appointment_id)
}

class AppointmentService implements IAppointmentService {
    - professional_service
    - client_service
    - working_hours_service
    - notification_service
    - appointment_repo

    + check_availability(professional, datetime_slot)
    + create_appointment(professional_id, client_id, datetime_slot)
    + get_by_id(appointment_id)
    + confirm_appointment(appointment_id)
    + cancel_appointment(appointment_id)
}

class Appointment {
    - id
    - duration
    - professional_id
    - client_id
    - datetime_slot
    - state
}

interface AppointmentRepository {
    + save(appointment)
    + get_by_id(appointment_id)
    + find_by_professional_and_datetime(professional_id, datetime)
    + update_state(appointment_id, state)
}

class PostgresAppointmentRepository implements AppointmentRepository {
    + save(appointment)
    + get_by_id(appointment_id)
    + find_by_professional_and_datetime(professional_id, datetime)
    + update_state(appointment_id, state)
}


' =========================
' CLIENT
' =========================

class Client {
    - id
    - name
    - email
    - phone
}

interface IClientService {
    + get_by_id(client_id)
}

class ClientService implements IClientService {
    - client_repo
    - client_validator

    + get_by_id(client_id)
}

interface ClientRepository {
    + save(client)
    + find_by_id(client_id)
}

class PostgresClientRepository implements ClientRepository {
    + save(client)
    + find_by_id(client_id)
}

class ClientValidator {
    + validate(data)
}


' =========================
' PROFESSIONAL
' =========================

class Professional {
    - id
    - name
    - specialty
    - working_hours
    - default_duration_minutes
}

class WorkingHours {
    - day_of_week
    - start_time
    - end_time
}

interface IProfessionalService {
    + create_professional()
    + get_by_id(professional_id)
}

class ProfessionalService implements IProfessionalService {
    - professional_repo
    - working_hours_service
    - professional_validator

    + create_professional()
    + get_by_id(professional_id)
}

interface ProfessionalRepository {
    + save(professional)
}

class PostgresProfessionalRepository implements ProfessionalRepository {
    + save(professional)
}

class ProfessionalValidator {
    + validate(data)
}

class WorkingHoursValidator {
    + validate(data)
}

interface IWorkingHoursService {
    + is_within_schedule(working_hours, datetime_slot)
}

class WorkingHoursService implements IWorkingHoursService {
    + is_within_schedule(working_hours, datetime_slot)
}


' =========================
' NOTIFICATION
' =========================

interface INotificationService {
    + send_confirmation(appointment, professional)
}

class NotificationService implements INotificationService {
    + send_confirmation(appointment, professional)
}


' =========================
' DATABASE
' =========================

interface DatabaseConnection {
    + connect()
}

class PostgresConnection implements DatabaseConnection {
    + connect()
}


' =========================
' DEPENDENCIES
' =========================

AppointmentRouter --> IAppointmentService

AppointmentService --> IProfessionalService
AppointmentService --> IClientService
AppointmentService --> IWorkingHoursService
AppointmentService --> INotificationService
AppointmentService --> AppointmentRepository
AppointmentService --> Appointment

AppointmentRepository --> Appointment
PostgresAppointmentRepository --> DatabaseConnection

ClientService --> ClientRepository
ClientService --> ClientValidator
ClientRepository --> Client
PostgresClientRepository --> DatabaseConnection

ProfessionalService --> ProfessionalRepository
ProfessionalService --> IWorkingHoursService
ProfessionalService --> ProfessionalValidator
ProfessionalRepository --> Professional
PostgresProfessionalRepository --> DatabaseConnection


Professional *-- WorkingHours

ProfessionalValidator --> WorkingHoursValidator

@enduml